# ============================================================
# 密钥模板:cp .env.example .env,然后填真实值
# .env 已被 .gitignore 挡在仓库外,真实密钥永远不入库
# 本文件只放"明显是假的"占位符,可以安全提交
# ============================================================

# ---- 模型 API(第 1 章起,选一家填)----
ANTHROPIC_API_KEY=sk-ant-替换成你的key
OPENAI_API_KEY=sk-替换成你的key
GLM_API_KEY=替换成你的key

# ---- OpenAI 兼容基地址(用智谱/中转站时改这里)----
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
