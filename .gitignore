# ===== 敏感信息:绝不入库 =====
.env
.env.*
*.env
!.env.example
secrets/
*.pem
*.key
credentials*.json
*apikey*.json

# ===== 语料与训练数据(可重新下载,不入库;课程内容数据 content/ 与卡图 svg/ 要入库)=====
data/*
# tinyshakespeare 语料(公共领域,4.4MB):课程必需,入库
!data/input.txt

# ===== Python(序章 · 搓丹线)=====
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ===== 模型训练产物(大文件)=====
*.pt
*.pth
*.ckpt
checkpoints/

# ===== Node(正文 · 铸剑线)=====
node_modules/
dist/
*.log
npm-debug.log*

# ===== macOS / 编辑器 =====
.DS_Store
.idea/
.vscode/
*.swp

